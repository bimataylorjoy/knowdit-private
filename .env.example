# LLM provider (any OpenAI-compatible chat-completions endpoint)
OPENAI_API_URL=https://api.openai.com/v1
OPENAI_API_MODEL=
OPENAI_API_KEY=
# Hard spending cap in USD for one process (0 disables the cap)
OPENAI_BILLING_CAP=100

# Optional request tuning
# LLM_REASONING_EFFORT=high     # provider-specific accepted values
# LLM_STREAM=true               # stream responses (useful behind proxies with short idle timeouts)
# LLM_FULL_MODEL_NAME=true      # send the model id verbatim, including any "vendor/" prefix
# LLM_CONTEXT_WINDOW=200000     # context window for models the client does not know

# Foundry toolchain (forge, cast) must be on PATH
# PATH=/path/to/foundry/bin:$PATH
